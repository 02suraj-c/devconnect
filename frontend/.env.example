# ──────────────────────────────────────────────
# DevConnect Frontend — Environment Variables
# Copy this file to .env and adjust if needed.
# ──────────────────────────────────────────────

# Backend API base URL (no trailing slash)
# Local:      http://localhost:5000/api
# Production: https://devconnect-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Backend Socket.io URL (no trailing slash, no /api)
# Local:      http://localhost:5000
# Production: https://devconnect-api.onrender.com
VITE_SOCKET_URL=http://localhost:5000

