# ──────────────────────────────────────────────
# DevConnect Backend — Environment Variables
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────

# MongoDB connection string (Atlas free tier works fine)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/devconnect?retryWrites=true&w=majority

# Secret used to sign JWTs — pick something long and random
JWT_SECRET=change_me_to_a_random_secret_string

# Frontend origin for CORS (update after deploying frontend)
CLIENT_URL=http://localhost:5173

# Port the server listens on (Render sets this automatically)
PORT=5000

# Node environment
NODE_ENV=development
